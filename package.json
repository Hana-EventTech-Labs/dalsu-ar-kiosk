{
  "name": "dalsu-ar-kiosk",
  "version": "0.1.0",
  "description": "삼성 달수 AR 포토카드 키오스크 (KIWW 2026, 대구 엑스코)",
  "private": true,
  "main": "kiosk/main.js",
  "scripts": {
    "start": "electron kiosk/main.js",
    "kiosk": "electron kiosk/main.js --kiosk",
    "smoke": "electron kiosk/main.js --smoke",
    "test": "node --test \"tests/**/*.test.js\"",
    "assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/convert-ai.ps1 && python scripts/keep-largest-blob.py kiosk/assets/dalsu-side.png kiosk/assets/dalsu-front.png kiosk/assets/dalsu-float.png kiosk/assets/dalsu-face.png && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-card-back.ps1",
    "build:printer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-printer.ps1",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "check": "npm test && npm run smoke",
    "build:demo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-demo.ps1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "kr.hanapf.dalsu.arkiosk",
    "productName": "DalsuARKiosk",
    "copyright": "Hana Platform",
    "directories": {
      "output": "dist/demo",
      "buildResources": "kiosk/assets"
    },
    "files": [
      "package.json",
      "kiosk/**/*",
      "!kiosk/assets/*.ico"
    ],
    "extraResources": [
      {
        "from": "printer/dist",
        "to": "printer"
      }
    ],
    "extraFiles": [
      {
        "from": "kiosk/config.json",
        "to": "config.json"
      },
      {
        "from": "scripts/start-demo-kiosk.cmd",
        "to": "start-demo-kiosk.cmd"
      },
      {
        "from": "docs/ONSITE_CHECKLIST.md",
        "to": "docs/ONSITE_CHECKLIST.md"
      }
    ],
    "asar": true,
    "win": {
      "icon": "kiosk/assets/icon.ico",
      "target": [
        "portable",
        "zip"
      ],
      "artifactName": "DalsuARKiosk-${version}-${os}.${ext}"
    },
    "portable": {
      "artifactName": "DalsuARKiosk-demo-${version}.exe"
    },
    "compression": "normal"
  },
  "author": "Hana Platform <hanalabs@hanapf.kr>"
}
